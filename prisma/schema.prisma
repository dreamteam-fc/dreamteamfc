generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Single URL for app + `prisma migrate deploy` (Railway preDeploy).
  // Prefer Supabase session pooler (:5432). Transaction pooler (:6543) can break migrations.
  url      = env("DATABASE_URL")
}

/// Platform/app role (not league membership — see LeagueRole).
/// USER: default registered user
/// MISTER: league ops + Fantacalcio vote upload (not platform God mode)
/// ADMIN: full /admin access including role assignment
enum UserRole {
  USER
  MISTER
  ADMIN
}

enum LeagueRole {
  OWNER
  MEMBER
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MatchdayStatus {
  DRAFT
  LINEUPS_OPEN
  LINEUPS_LOCKED
  VOTES_PENDING
  VOTES_COMPLETED
  SCORES_CALCULATED
  PUBLISHED
  LOCKED
}

enum LineupStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum SlotType {
  STARTER
  BENCH
}

enum RequiredVoteStatus {
  PENDING
  COMPLETED
  SV
  IGNORED
}

enum VoteStatus {
  PENDING
  CONFIRMED
}

enum ScoreStatus {
  CALCULATED
  PUBLISHED
  LOCKED
}

enum ScorePlayerFinalType {
  STARTER_PLAYED
  REPLACED_BY_BENCH
  AUTO_SUB_IN
  SV_NOT_REPLACED
  BENCH_UNUSED
}

enum FantasyFixtureStatus {
  SCHEDULED
  CALCULATED
  PUBLISHED
  LOCKED
}

enum PlayerRole {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  ATTACKER
}

enum TeamCoachInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  // Collegamento futuro all'utente di Supabase Auth mantenendo un ID interno separato per l'app.
  authUserId    String?        @unique
  displayName   String?
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leagues       League[]       @relation("LeagueCreator")
  leagueMembers LeagueMember[]
  fantasyTeams  FantasyTeam[]
  coachInvitesSent     TeamCoachInvite[] @relation("TeamCoachInvitesSent")
  coachInvitesReceived TeamCoachInvite[] @relation("TeamCoachInvitesReceived")
  teamCoaching         TeamCoach[]       @relation("TeamCoachUser")
  teamCoachesGranted   TeamCoach[]       @relation("TeamCoachGrantedBy")
  tournamentsCreated   Tournament[]      @relation("TournamentCreator")
}

model League {
  id             String                @id @default(cuid())
  name           String
  status         LeagueStatus          @default(DRAFT)
  startersCount  Int                   @default(5)
  maxAutoSubs    Int                   @default(1)
  maxTeams       Int                   @default(10)
  /// Hash password iscrizione lega (mai in chiaro). Formato salt:hash scrypt.
  passwordHash   String?
  createdById    String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  createdBy      User                  @relation("LeagueCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members        LeagueMember[]
  fantasyTeams   FantasyTeam[]
  matchdays      Matchday[]
  blockedPlayers LeagueBlockedPlayer[]
  rosterEntries  FantasyRoster[]
  tournamentEntries TournamentTeamEntry[]

  @@index([createdById])
}

model LeagueMember {
  id        String     @id @default(cuid())
  leagueId  String
  userId    String
  role      LeagueRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  league    League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leagueId, userId])
  @@index([userId])
}

model Player {
  id               String                @id @default(cuid())
  name             String
  role             PlayerRole            @default(MIDFIELDER)
  teamName         String?
  externalId       String?
  source           String?
  isActive         Boolean               @default(true)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  rosterEntries    FantasyRoster[]
  lineupPlayers    LineupPlayer[]
  requiredVotes    RequiredVotePlayer[]
  votes            PlayerVote[]
  teamScorePlayers TeamScorePlayer[]
  leagueBlocks     LeagueBlockedPlayer[]
  tournamentLineupPlayers TournamentLineupPlayer[]
  tournamentRequiredVotes TournamentRequiredVotePlayer[]
  tournamentVotes         TournamentPlayerVote[]

  @@unique([source, externalId])
}

model LeagueBlockedPlayer {
  id        String   @id @default(cuid())
  leagueId  String
  playerId  String
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([leagueId, playerId])
  @@index([leagueId])
  @@index([playerId])
}

model FantasyTeam {
  id           String           @id @default(cuid())
  leagueId     String
  userId       String
  name         String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  league       League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roster       FantasyRoster[]
  lineups      Lineup[]
  teamScores   TeamScore[]
  homeFixtures FantasyFixture[] @relation("FantasyFixtureHomeTeam")
  awayFixtures FantasyFixture[] @relation("FantasyFixtureAwayTeam")
  coachInvites TeamCoachInvite[]
  coaches      TeamCoach[]
  tournamentEntries TournamentTeamEntry[]
  tournamentHomeFixtures TournamentFixture[] @relation("TournamentFixtureHomeTeam")
  tournamentAwayFixtures TournamentFixture[] @relation("TournamentFixtureAwayTeam")
  tournamentLineups TournamentLineup[]

  @@unique([leagueId, userId])
  @@index([userId])
}

model TeamCoachInvite {
  id            String                @id @default(cuid())
  fantasyTeamId String
  invitedById   String
  inviteeEmail  String
  inviteeUserId String?
  tokenHash     String                @unique
  status        TeamCoachInviteStatus @default(PENDING)
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  fantasyTeam   FantasyTeam           @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  invitedBy     User                  @relation("TeamCoachInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  inviteeUser   User?                 @relation("TeamCoachInvitesReceived", fields: [inviteeUserId], references: [id], onDelete: SetNull)
  acceptedCoach TeamCoach?

  @@index([fantasyTeamId, status])
  @@index([inviteeEmail, status])
}

/// Delega attiva (o revocata) per impostare solo la formazione di una squadra.
model TeamCoach {
  id            String          @id @default(cuid())
  fantasyTeamId String
  userId        String
  invitedById   String
  inviteId      String?         @unique
  createdAt     DateTime        @default(now())
  revokedAt     DateTime?
  fantasyTeam   FantasyTeam     @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  user          User            @relation("TeamCoachUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy     User            @relation("TeamCoachGrantedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  invite        TeamCoachInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)

  @@unique([fantasyTeamId, userId])
  @@index([userId])
  @@index([fantasyTeamId, revokedAt])
}

model FantasyRoster {
  id            String      @id @default(cuid())
  fantasyTeamId String
  /// Denormalized from FantasyTeam.leagueId for league-wide player exclusivity.
  leagueId      String
  playerId      String
  createdAt     DateTime    @default(now())
  fantasyTeam   FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  league        League      @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  player        Player      @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([fantasyTeamId, playerId])
  /// Same player cannot sit on multiple fantasy teams in the same league.
  @@unique([leagueId, playerId])
  @@index([playerId])
  @@index([leagueId])
}

model Matchday {
  id               String               @id @default(cuid())
  leagueId         String
  number           Int
  status           MatchdayStatus       @default(DRAFT)
  lineupDeadlineAt DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  league           League               @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  lineups          Lineup[]
  requiredVotes    RequiredVotePlayer[]
  playerVotes      PlayerVote[]
  teamScores       TeamScore[]
  fixtures         FantasyFixture[]

  @@unique([leagueId, number])
  @@index([leagueId, status])
}

model Lineup {
  id            String         @id @default(cuid())
  fantasyTeamId String
  matchdayId    String
  status        LineupStatus   @default(DRAFT)
  submittedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fantasyTeam   FantasyTeam    @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  matchday      Matchday       @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  players       LineupPlayer[]
  teamScore     TeamScore?

  @@unique([fantasyTeamId, matchdayId])
  @@index([matchdayId, status])
}

model LineupPlayer {
  id                   String            @id @default(cuid())
  lineupId             String
  playerId             String
  slotType             SlotType
  positionOrder        Int
  createdAt            DateTime          @default(now())
  lineup               Lineup            @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player               Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  scoreEntries         TeamScorePlayer[] @relation("ScoreEntryLineupPlayer")
  replacedScoreEntries TeamScorePlayer[] @relation("ReplacedLineupPlayer")

  @@unique([lineupId, playerId])
  @@unique([lineupId, slotType, positionOrder])
  @@index([playerId])
}

model RequiredVotePlayer {
  id         String             @id @default(cuid())
  matchdayId String
  playerId   String
  status     RequiredVoteStatus @default(PENDING)
  usageCount Int                @default(1)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  matchday   Matchday           @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  player     Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([matchdayId, playerId])
  @@index([status])
}

model PlayerVote {
  id               String            @id @default(cuid())
  matchdayId       String
  playerId         String
  status           VoteStatus        @default(PENDING)
  // Backend validation: if isSv is true, baseVote and finalFantavote must be null.
  isSv             Boolean           @default(false)
  // Backend validation: if isSv is false, baseVote is required.
  baseVote         Decimal?          @db.Decimal(4, 2)
  goals            Int               @default(0)
  goalsConceded    Int               @default(0)
  assists          Int               @default(0)
  yellowCards      Int               @default(0)
  redCards         Int               @default(0)
  ownGoals         Int               @default(0)
  penaltiesMissed  Int               @default(0)
  penaltiesSaved   Int               @default(0)
  /// RF: rigori realizzati (tracciamento; il gol e gia in `goals`, nessun bonus extra)
  penaltiesScored  Int               @default(0)
  cleanSheet       Int               @default(0)
  // Backend validation: finalFantavote must be calculated server-side, never by the client.
  finalFantavote   Decimal?          @db.Decimal(5, 2)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  matchday         Matchday          @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  player           Player            @relation(fields: [playerId], references: [id], onDelete: Restrict)
  teamScorePlayers TeamScorePlayer[]

  @@unique([matchdayId, playerId])
  @@index([status, isSv])
}

model TeamScore {
  id               String            @id @default(cuid())
  fantasyTeamId    String
  matchdayId       String
  lineupId         String            @unique
  status           ScoreStatus       @default(CALCULATED)
  totalScore       Decimal?          @db.Decimal(6, 2)
  autoSubsUsed     Int               @default(0)
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fantasyTeam      FantasyTeam       @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  matchday         Matchday          @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  lineup           Lineup            @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  players          TeamScorePlayer[]
  homeTeamFixtures FantasyFixture[]  @relation("FantasyFixtureHomeTeamScore")
  awayTeamFixtures FantasyFixture[]  @relation("FantasyFixtureAwayTeamScore")

  @@unique([fantasyTeamId, matchdayId])
  @@index([matchdayId, status])
}

model TeamScorePlayer {
  id                     String               @id @default(cuid())
  teamScoreId            String
  lineupPlayerId         String
  playerId               String
  playerVoteId           String?
  replacedLineupPlayerId String?
  finalType              ScorePlayerFinalType
  slotType               SlotType
  positionOrder          Int
  countsForScore         Boolean              @default(false)
  isSv                   Boolean              @default(false)
  finalFantavote         Decimal?             @db.Decimal(5, 2)
  createdAt              DateTime             @default(now())
  teamScore              TeamScore            @relation(fields: [teamScoreId], references: [id], onDelete: Cascade)
  lineupPlayer           LineupPlayer         @relation("ScoreEntryLineupPlayer", fields: [lineupPlayerId], references: [id], onDelete: Restrict)
  player                 Player               @relation(fields: [playerId], references: [id], onDelete: Restrict)
  playerVote             PlayerVote?          @relation(fields: [playerVoteId], references: [id], onDelete: SetNull)
  replacedLineupPlayer   LineupPlayer?        @relation("ReplacedLineupPlayer", fields: [replacedLineupPlayerId], references: [id], onDelete: SetNull)

  @@unique([teamScoreId, lineupPlayerId])
  @@index([teamScoreId, finalType])
  @@index([playerId])
}

model FantasyFixture {
  id              String               @id @default(cuid())
  matchdayId      String
  homeTeamId      String
  awayTeamId      String
  homeTeamScoreId String?              @unique
  awayTeamScoreId String?              @unique
  homeGoals       Int?
  awayGoals       Int?
  status          FantasyFixtureStatus @default(SCHEDULED)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  matchday        Matchday             @relation(fields: [matchdayId], references: [id], onDelete: Cascade)
  homeTeam        FantasyTeam          @relation("FantasyFixtureHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam        FantasyTeam          @relation("FantasyFixtureAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  homeTeamScore   TeamScore?           @relation("FantasyFixtureHomeTeamScore", fields: [homeTeamScoreId], references: [id], onDelete: SetNull)
  awayTeamScore   TeamScore?           @relation("FantasyFixtureAwayTeamScore", fields: [awayTeamScoreId], references: [id], onDelete: SetNull)

  @@unique([matchdayId, homeTeamId, awayTeamId])
  @@index([matchdayId])
}

enum TournamentStatus {
  DRAFT
  ENTRIES_SET
  BRACKET_GENERATED
  IN_PROGRESS
  COMPLETED
}

/// Torneo cross-lega post-campionato (dominio separato da League/Matchday).
model Tournament {
  id           String                   @id @default(cuid())
  name         String
  status       TournamentStatus         @default(DRAFT)
  /// Hash password iscrizione torneo (mai in chiaro).
  passwordHash String
  /// Se true, le squadre attivate possono schierare formazioni sulle partite READY.
  lineupsOpen  Boolean                  @default(true)
  createdById  String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  createdBy    User                     @relation("TournamentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  entries      TournamentTeamEntry[]
  rounds       TournamentRound[]

  @@index([createdById])
  @@index([status])
}

model TournamentTeamEntry {
  id              String      @id @default(cuid())
  tournamentId    String
  fantasyTeamId   String
  sourceLeagueId  String
  /// Punti classifica di lega al momento della selezione (snapshot).
  seedPoints      Int         @default(0)
  /// Rank seeding 1 = più alto. Valorizzato alla generazione tabellone.
  seedRank        Int?
  /// Null finche il proprietario non sblocca con la password torneo.
  activatedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fantasyTeam     FantasyTeam @relation(fields: [fantasyTeamId], references: [id], onDelete: Restrict)
  sourceLeague    League      @relation(fields: [sourceLeagueId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, fantasyTeamId])
  @@index([tournamentId])
  @@index([sourceLeagueId])
}

enum TournamentFixtureStatus {
  SCHEDULED
  READY
  COMPLETED
}

model TournamentRound {
  id           String              @id @default(cuid())
  tournamentId String
  /// 0 = prima fase, poi crescente fino alla finale.
  roundIndex   Int
  name         String
  isFinal      Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tournament   Tournament          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  fixtures     TournamentFixture[]
  requiredVotes TournamentRequiredVotePlayer[]
  playerVotes   TournamentPlayerVote[]

  @@unique([tournamentId, roundIndex])
  @@index([tournamentId])
}

/// Partita (o gamba) di un torneo. Serie A/R condividono seriesKey.
model TournamentFixture {
  id            String                  @id @default(cuid())
  roundId       String
  /// Slot nel tabellone della fase (0..n/2-1).
  bracketSlot   Int
  /// Chiave serie: stesso valore per andata e ritorno.
  seriesKey     String
  /// 1 = andata, 2 = ritorno (finale solo leg=1).
  leg           Int                     @default(1)
  homeTeamId    String?
  awayTeamId    String?
  homeGoals     Int?
  awayGoals     Int?
  status        TournamentFixtureStatus @default(SCHEDULED)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  round         TournamentRound         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  homeTeam      FantasyTeam?            @relation("TournamentFixtureHomeTeam", fields: [homeTeamId], references: [id], onDelete: Restrict)
  awayTeam      FantasyTeam?            @relation("TournamentFixtureAwayTeam", fields: [awayTeamId], references: [id], onDelete: Restrict)
  lineups       TournamentLineup[]

  @@unique([roundId, seriesKey, leg])
  @@index([roundId, bracketSlot])
  @@index([homeTeamId])
  @@index([awayTeamId])
}

model TournamentLineup {
  id                  String                   @id @default(cuid())
  fantasyTeamId       String
  tournamentFixtureId String
  status              LineupStatus             @default(SUBMITTED)
  submittedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  fantasyTeam         FantasyTeam              @relation(fields: [fantasyTeamId], references: [id], onDelete: Cascade)
  tournamentFixture   TournamentFixture        @relation(fields: [tournamentFixtureId], references: [id], onDelete: Cascade)
  players             TournamentLineupPlayer[]

  @@unique([fantasyTeamId, tournamentFixtureId])
  @@index([tournamentFixtureId, status])
}

model TournamentLineupPlayer {
  id            String           @id @default(cuid())
  lineupId      String
  playerId      String
  slotType      SlotType
  positionOrder Int
  createdAt     DateTime         @default(now())
  lineup        TournamentLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player        Player           @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([lineupId, playerId])
  @@unique([lineupId, slotType, positionOrder])
  @@index([playerId])
}

/// Lista voti richiesti per una fase di torneo (unione giocatori nelle formazioni READY).
model TournamentRequiredVotePlayer {
  id       String             @id @default(cuid())
  roundId  String
  playerId String
  status   RequiredVoteStatus @default(PENDING)
  usageCount Int              @default(1)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  round    TournamentRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player   Player             @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([roundId, playerId])
  @@index([status])
}

/// Voti giocatore scoped alla fase torneo (import XLS Fantacalcio).
model TournamentPlayerVote {
  id              String     @id @default(cuid())
  roundId         String
  playerId        String
  status          VoteStatus @default(PENDING)
  isSv            Boolean    @default(false)
  baseVote        Decimal?   @db.Decimal(4, 2)
  goals           Int        @default(0)
  goalsConceded   Int        @default(0)
  assists         Int        @default(0)
  yellowCards     Int        @default(0)
  redCards        Int        @default(0)
  ownGoals        Int        @default(0)
  penaltiesMissed Int        @default(0)
  penaltiesSaved  Int        @default(0)
  penaltiesScored Int        @default(0)
  cleanSheet      Int        @default(0)
  finalFantavote  Decimal?   @db.Decimal(5, 2)
  notes           String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  round           TournamentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player          Player          @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@unique([roundId, playerId])
  @@index([status, isSv])
}
