# Supabase PostgreSQL — used by the app and by `prisma migrate deploy` (Railway preDeploy).
# Prefer Session pooler (:5432) so migrations work without a separate DIRECT_URL.
# Transaction pooler (:6543) is fine for the app but migrations often fail there.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth / client
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Opzionale — origine pubblica assoluta (invite coach, redirect auth).
# Se assente si usano gli header della richiesta (Railway) o VERCEL_URL.
# NEXT_PUBLIC_APP_URL="https://tuo-dominio.example"

# Fallback legacy (usata solo se manca la publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"

# Server-only — upload loghi squadra su Storage (bucket team-logos).
# Mai esporre al client. Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# Opzionale — bootstrap platform admin (promuove questa email a UserRole.ADMIN al login
# solo se non esiste già alcun Admin). Poi User.role in DB è source of truth; assegna Admin/Mister da /admin.
ADMIN_EMAIL=""

# Opzionali — import giocatori API-Football
API_FOOTBALL_KEY=""
API_FOOTBALL_SERIE_A_LEAGUE_ID="135"
API_FOOTBALL_SEASON=""
API_FOOTBALL_REQUEST_DELAY_MS="1500"
API_FOOTBALL_MAX_TEAMS_PER_RUN=""
API_FOOTBALL_START_TEAM_INDEX=""
