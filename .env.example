# Supabase PostgreSQL — app runtime (Transaction pooler :6543).
# Must include ?pgbouncer=true (Prisma). Optional: &connection_limit=1 to hold fewer slots.
# Do NOT use Session pooler (:5432) for DATABASE_URL on Railway — Free tier ~15 session
# slots; the live app fills them and preDeploy migrate cannot connect (EMAXCONNSESSION).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Required for Prisma migrate (schema directUrl). Prefer DIRECT_URL when set.
#
# On Railway (IPv4-only): Supabase Direct (db.*.supabase.co) is often IPv6-only → P1001.
# Use Session mode pooler as DIRECT_URL instead (brief migrate-only connection):
#   Supabase Connect → Session → host *.pooler.supabase.com:5432
#   user often postgres.PROJECT_REF
# Use true Direct (db.PROJECT_REF.supabase.co:5432) only if IPv4 add-on or IPv6 works.
# Never use Transaction pooler (:6543) for migrate / DIRECT_URL.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth / client
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Opzionale — origine pubblica assoluta (invite coach, redirect auth).
# Se assente si usano gli header della richiesta (Railway) o VERCEL_URL.
# NEXT_PUBLIC_APP_URL="https://tuo-dominio.example"

# Fallback legacy (usata solo se manca la publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"

# Server-only — upload loghi squadra su Storage (bucket team-logos).
# Mai esporre al client. Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="REPLACE_ME"

# Opzionale — bootstrap platform admin (promuove questa email a UserRole.ADMIN al login
# solo se non esiste già alcun Admin). Poi User.role in DB è source of truth; assegna Admin/Mister da /admin.
ADMIN_EMAIL=""

# Opzionali — import giocatori API-Football
API_FOOTBALL_KEY=""
API_FOOTBALL_SERIE_A_LEAGUE_ID="135"
API_FOOTBALL_SEASON=""
API_FOOTBALL_REQUEST_DELAY_MS="1500"
API_FOOTBALL_MAX_TEAMS_PER_RUN=""
API_FOOTBALL_START_TEAM_INDEX=""
