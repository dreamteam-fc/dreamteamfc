# Supabase PostgreSQL — runtime (Transaction pooler consigliato, porta 6543)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Supabase Auth / client
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Fallback legacy (usata solo se manca la publishable key)
NEXT_PUBLIC_SUPABASE_ANON_KEY="REPLACE_ME"

# Opzionale — bootstrap platform admin (promuove questa email a UserRole.ADMIN al login
# solo se non esiste già alcun Admin). Poi User.role in DB è source of truth; assegna Admin/Mister da /admin.
ADMIN_EMAIL=""

# Opzionali — import giocatori API-Football
API_FOOTBALL_KEY=""
API_FOOTBALL_SERIE_A_LEAGUE_ID="135"
API_FOOTBALL_SEASON=""
API_FOOTBALL_REQUEST_DELAY_MS="1500"
API_FOOTBALL_MAX_TEAMS_PER_RUN=""
API_FOOTBALL_START_TEAM_INDEX=""
